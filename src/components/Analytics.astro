---
// Google tag (GA4) exactly as provided by Google Analytics for this property.
// Only rendered in production builds so local development does not pollute the statistics.
const MEASUREMENT_ID = 'G-FNSBZN1TJN';
const enabled = import.meta.env.PROD;
const inlineScript = `window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
gtag('js', new Date());`;
---
{enabled && (
  <>
    <script is:inline async src={`https://www.googletagmanager.com/gtm.js?id=${MEASUREMENT_ID}`}></script>
    <script is:inline set:html={inlineScript}></script>
  </>
)}
