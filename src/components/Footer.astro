---
import { SITE } from '../site';
import SocialLinks from './SocialLinks.astro';

const brand = SITE.title.replace('~/', '');
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container">
    <div>
      <a class="brand" href="/">
        <span class="brand-path">~/</span>{brand}
      </a>
      <p>$ exit · {SITE.author.name} · 2016–{year} · <a href={SITE.url}>{SITE.urlPretty}</a></p>
    </div>
    <SocialLinks />
  </div>
</footer>
