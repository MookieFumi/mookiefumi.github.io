---
import { SITE } from '../site';
// Estilos propios: Astro los empaqueta con hash en el nombre, así que pueden cachearse sin caducidad.
import '../styles/tokens.css';
import '../styles/site.css';
// Fuentes autoalojadas: Astro empaqueta el CSS y los ficheros con hash, así que no
// hay peticiones a terceros. Solo se precargan los subconjuntos latinos.
import '@fontsource-variable/geist/wght.css';
import '@fontsource-variable/geist-mono/wght.css';
import geistLatin from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import geistMonoLatin from '@fontsource-variable/geist-mono/files/geist-mono-latin-wght-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
  article?: boolean;
  // Ruta absoluta a usar como canonical en lugar de la propia (traducciones).
  canonical?: string;
  // Fecha de publicación y tema del post (solo artículos).
  published?: Date;
  modified?: Date;
  section?: string;
  // Id del tema, para el breadcrumb (`/topics#id`).
  sectionId?: string;
}
const { title, description, article = false, canonical, published, modified, section, sectionId } = Astro.props;

// Google corta los títulos hacia los 60 caracteres: la marca solo se añade si cabe.
const homeTitle = 'Blog de arquitectura .NET, calidad, CI/CD e IA';
const pageTitle = title ?? homeTitle;
const withBrand = `${pageTitle} · ${SITE.title}`;
const fullTitle = withBrand.length <= 60 ? withBrand : pageTitle;
const metaDescription = description ?? SITE.description;
// Las URLs públicas no llevan `.html` (`/topics`, `/page2/`, `/`).
const ogImage = `${SITE.url}/img/brand/mookie-og.png`;
const path = Astro.url.pathname.replace(/\.html$/, '');

// Datos estructurados (JSON-LD): el autor en todas las páginas, BlogPosting y
// breadcrumbs en los posts, WebSite en la portada y ProfilePage en /aboutme.
const personId = `${SITE.url}/#person`;
const person = {
  '@type': 'Person',
  '@id': personId,
  name: SITE.author.name,
  url: `${SITE.url}/aboutme`,
  image: `${SITE.url}${SITE.avatar}`,
  jobTitle: 'Software / Cloud Solution Architect',
  sameAs: [
    `https://github.com/${SITE.author.github}`,
    `https://twitter.com/${SITE.author.twitter}`,
    `https://linkedin.com/${SITE.author.linkedin}`,
  ],
};
const pageUrl = `${SITE.url}${canonical ?? path}`;
const graph: object[] = [];
if (path === '/') {
  graph.push({ '@type': 'WebSite', '@id': `${SITE.url}/#website`, url: SITE.url, name: SITE.title, description: SITE.description, inLanguage: 'es', publisher: { '@id': personId } }, person);
} else if (path === '/aboutme') {
  graph.push({ '@type': 'ProfilePage', url: pageUrl, name: title, mainEntity: person });
} else if (article) {
  graph.push(
    {
      '@type': 'BlogPosting',
      headline: title,
      description: metaDescription,
      datePublished: published?.toISOString().slice(0, 10),
      dateModified: (modified ?? published)?.toISOString().slice(0, 10),
      author: { '@id': personId },
      image: ogImage,
      inLanguage: 'es',
      mainEntityOfPage: pageUrl,
      publisher: { '@id': personId },
    },
    person,
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: SITE.title, item: SITE.url },
        ...(section && sectionId ? [{ '@type': 'ListItem', position: 2, name: section, item: `${SITE.url}/topics#${sectionId}` }] : []),
        { '@type': 'ListItem', position: section && sectionId ? 3 : 2, name: title, item: pageUrl },
      ],
    },
  );
}
// `<` escapado para que ningún texto pueda cerrar la etiqueta <script>.
const jsonLd = graph.length ? JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\\u003c') : undefined;
---
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <title>{fullTitle}</title>

  <meta name="author" content={SITE.author.name}>
  <meta name="description" content={metaDescription}>
  <meta name="robots" content="max-image-preview:large">
  {path !== '/404' && <link rel="canonical" href={`${SITE.url}${canonical ?? path}`}>}

  <!-- Aplica el tema guardado antes de pintar para evitar un destello -->
  <script is:inline>
    try {
      if (localStorage.getItem('theme') === 'light') document.documentElement.setAttribute('data-theme', 'light');
    } catch (e) {}
  </script>

  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <meta name="theme-color" content="#05070A">

  <link rel="preload" href={geistLatin} as="font" type="font/woff2" crossorigin>
  <link rel="preload" href={geistMonoLatin} as="font" type="font/woff2" crossorigin>

  <slot />

  <link rel="alternate" type="application/rss+xml" title={`${SITE.title} - ${SITE.description}`} href="/feed.xml">

  <!-- Open Graph -->
  <meta property="og:site_name" content={SITE.title}>
  <meta property="og:locale" content="es_ES">
  <meta property="og:title" content={pageTitle}>
  <meta property="og:type" content={article ? 'article' : 'website'}>
  <meta property="og:url" content={`${SITE.url}${path}`}>
  <meta property="og:description" content={metaDescription}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content={SITE.title}>
  {article && published && <meta property="article:published_time" content={published.toISOString()}>}
  {article && modified && <meta property="article:modified_time" content={modified.toISOString()}>}
  {article && <meta property="article:author" content={SITE.author.name}>}
  {article && section && <meta property="article:section" content={section}>}

  <!-- X / Twitter -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:creator" content={`@${SITE.author.twitter}`}>
  <meta name="twitter:title" content={pageTitle}>
  <meta name="twitter:description" content={metaDescription}>
  <meta name="twitter:image" content={ogImage}>
  {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
</head>
