---
// La pirámide de tests con los tipos de test de entry-hub en cada escalón. Las bandas se
// calculan a partir de la lista de abajo.
// La cima es más alta que el resto para que su texto quepa cerca del pico.
const levels = [
  { name: 'End-to-end', color: '#56d4dd', height: 150 },
  { name: 'Contrato', color: '#b392f0', height: 72 },
  { name: 'Integración amplia', color: '#6cb6ff', height: 72 },
  { name: 'Integración estrecha', color: '#6cb6ff', height: 72 },
  { name: 'Unitario', color: '#57d38c', height: 72 },
];

const top = 12;
const center = 320;
const baseHalf = 310;
const total = levels.reduce((sum, level) => sum + level.height, 0);
const half = (y: number) => (baseHalf * (y - top)) / total;

let y1 = top;
const bands = levels.map((level) => {
  const y2 = y1 + level.height;
  const points = [
    [center - half(y1), y1],
    [center + half(y1), y1],
    [center + half(y2), y2],
    [center - half(y2), y2],
  ].map(([x, y]) => `${x.toFixed(1)},${y}`).join(' ');
  // El texto va en la parte baja de cada banda, donde es más ancha.
  const band = { ...level, points, nameY: y2 - 22 };
  y1 = y2;
  return band;
});
---
<figure class="pyramid">
  <div class="pyramid-bar">
    <span class="pyramid-dot" style="background:#ff5f56"></span><span class="pyramid-dot" style="background:#ffbd2e"></span><span class="pyramid-dot" style="background:#27c93f"></span>
    <span class="pyramid-path">~/entry-hub/src/tests · pirámide de tests</span>
  </div>
  <svg viewBox={`0 0 ${center * 2} ${top * 2 + total}`} role="img" aria-labelledby="pyramid-title">
    <title id="pyramid-title">Pirámide de tests de entry-hub: unitarios en la base; integración estrecha, integración amplia y contrato en el medio; y end-to-end en la cima.</title>
    {bands.map((band) => (
      <g>
        <polygon points={band.points} fill={band.color} fill-opacity="0.14" stroke={band.color} stroke-width="1.2" stroke-linejoin="round" />
        <text x={center} y={band.nameY} class="name">{band.name}</text>
      </g>
    ))}
  </svg>
</figure>

<style>
  .pyramid {
    --mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    margin-block: 24px;
    border: 1px solid #30363d;
    background: #0d1117;
    color: #c9d1d9;
    font: 12px/1.45 var(--mono);
  }
  .pyramid-bar {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 9px 12px;
    border-bottom: 1px solid #30363d;
  }
  .pyramid-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }
  .pyramid .pyramid-path {
    margin-left: 8px;
    color: #8b949e;
    font-size: 11px;
  }
  svg {
    display: block;
    width: 100%;
    max-width: 640px;
    height: auto;
    margin-inline: auto;
    padding: 12px;
    box-sizing: border-box;
  }
  text {
    font-family: var(--mono);
    text-anchor: middle;
  }
  .name {
    font-size: 18px;
    font-weight: 700;
    fill: #e6edf3;
  }
</style>
