---
import Head from '../components/Head.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  article?: boolean;
  canonical?: string;
  published?: Date;
  section?: string;
  sectionId?: string;
}
const { title, description, article, canonical, published, section, sectionId } = Astro.props;
---
<!DOCTYPE html>
<html lang="es">
  <Head title={title} description={description} article={article} canonical={canonical} published={published} section={section} sectionId={sectionId}><slot name="head" /></Head>
  <body>
    <Nav />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
    <script is:inline src="/js/site.js"></script>
    <slot name="scripts" />
    <!-- Cloudflare Web Analytics --><script is:inline type='module' src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "e95cc07b53044249b258add717d68750"}'></script><!-- End Cloudflare Web Analytics -->
  </body>
</html>
