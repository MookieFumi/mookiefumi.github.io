---
import { getEntry } from 'astro:content';
import { SITE } from '../site';
import Base from './Base.astro';
import WindowBar from '../components/WindowBar.astro';
import Prompt from '../components/Prompt.astro';
import TopicChip from '../components/TopicChip.astro';
import PostCard from '../components/PostCard.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { formatDate, isoDate } from '../lib/dates';
import { metaDescription, readingTime } from '../lib/text';
import { getPublishedPosts, getSeriesPosts, postHtml, postSlug, type Post } from '../lib/posts';

interface Props {
  post: Post;
  // Post anterior (más antiguo) y siguiente (más reciente).
  previous?: Post;
  next?: Post;
}
const { post, previous, next } = Astro.props;
const { title, subtitle, description, date, canonicalPost } = post.data;
const html = postHtml(post);
const topic = await getEntry(post.data.topic);

// La serie a la que pertenece el post, si tiene, con todos sus posts en orden.
const series = post.data.series ? await getEntry(post.data.series) : undefined;
const seriesPosts = series ? await getSeriesPosts(series.id) : [];

// Hasta 3 posts del mismo tema, los más cercanos en el tiempo. No se sugieren
// las traducciones (posts con `canonicalPost`), este mismo post ni los que ya
// salen en el cuadro de la serie.
const related = (await getPublishedPosts())
  .filter((other) => other.data.topic.id === post.data.topic.id && other.id !== post.id)
  .filter((other) => !other.data.canonicalPost)
  .filter((other) => !seriesPosts.some((inSeries) => inSeries.id === other.id))
  .sort((a, b) => Math.abs(a.data.date.valueOf() - date.valueOf()) - Math.abs(b.data.date.valueOf() - date.valueOf()))
  .slice(0, 3);
---
<Base title={title} description={description ?? subtitle ?? metaDescription(html)} article canonical={canonicalPost && `/${canonicalPost}`} published={date} section={topic?.data.name} sectionId={topic?.id}>
  <article class={`topic-${post.data.topic.id}`}>
    <header class="post-hero container-narrow">
      <div class="window">
        <WindowBar title="bash — ~/mookie/posts" />
        <div class="window-body">
          <Prompt path="~/posts" cmd={`cat ${postSlug(post).slice(0, 60)}.md`} />
          {topic && <div><TopicChip id={topic.id} /></div>}
          <h1>{title}</h1>
        </div>
      </div>
    </header>

    <div class="container-narrow">
      <div class="post-intro">
        {subtitle && <p class="subtitle">{subtitle}</p>}
        <div class="byline">
          <img src={SITE.avatar} alt="" width="40" height="40">
          <div>
            <strong>{SITE.author.name}</strong>
            <span class="meta"><time datetime={isoDate(date)}>{formatDate(date)}</time> · {readingTime(html)} de lectura</span>
          </div>
        </div>
      </div>

      <div class="prose">
        <slot />
      </div>

      {series && seriesPosts.length > 1 && (
        <nav class="series-box" aria-labelledby="series-title">
          <h2 id="series-title">Serie · <a href={`/series/${series.id}`}>{series.data.name}</a></h2>
          <ol>
            {seriesPosts.map((other) => (
              <li>
                {other.id === post.id
                  ? <span aria-current="page">{other.data.title}</span>
                  : <a href={`/${other.id}`}>{other.data.title}</a>}
              </li>
            ))}
          </ol>
        </nav>
      )}

      <aside class="author-card" aria-label="Sobre el autor">
        <img src={SITE.avatar} alt="" width="64" height="64">
        <div>
          <h2>{SITE.author.name}</h2>
          <p>Software / Cloud Solution Architect y Technical Lead .NET. Escribo sobre .NET, C#, SDD e IA: buenas prácticas y patrones que aguantan en producción.</p>
          <SocialLinks />
        </div>
      </aside>

      {related.length > 0 && (
        <section class="related" aria-labelledby="related-title">
          <h2 id="related-title">Sigue leyendo{topic && ` · ${topic.data.name}`}</h2>
          <ul class="post-grid">
            {related.map((other) => <PostCard post={other} />)}
          </ul>
        </section>
      )}

      {(previous || next) && (
        <nav class="post-nav" aria-label="Más artículos">
          {previous && (
            <a class={`prev topic-${previous.data.topic.id}`} href={`/${previous.id}`}>
              <span class="label">← Anterior</span>
              <strong>{previous.data.title}</strong>
            </a>
          )}
          {next && (
            <a class={`next topic-${next.data.topic.id}`} href={`/${next.id}`}>
              <span class="label">Siguiente →</span>
              <strong>{next.data.title}</strong>
            </a>
          )}
        </nav>
      )}
    </div>
  </article>
</Base>
